# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ⚠️ .env.local ห้าม commit ขึ้น git เด็ดขาด

# ── Database (Supabase / Neon / Vercel Postgres) ──
# สมัคร Supabase ฟรีที่ supabase.com → Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ── LLM API ──
# API key จาก https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Dev mode ──
# ตั้งเป็น true เพื่อใช้ mock data (คน B พัฒนา UI ได้โดยไม่ต้องมี API key)
# ถ้าไม่มี ANTHROPIC_API_KEY ระบบจะใช้ mock ให้อัตโนมัติอยู่แล้ว
USE_MOCK=false
