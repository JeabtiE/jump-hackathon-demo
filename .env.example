# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ⚠️ .env.local ห้าม commit ขึ้น git เด็ดขาด

# API key จาก https://console.anthropic.com
ANTHROPIC_API_KEY=

# ตั้งเป็น true เพื่อใช้ mock data (คน B พัฒนา UI ได้โดยไม่ต้องมี key)
# ถ้าไม่มี ANTHROPIC_API_KEY ระบบจะใช้ mock ให้อัตโนมัติอยู่แล้ว
USE_MOCK=false
