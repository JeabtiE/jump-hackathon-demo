# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ⚠️ .env ห้าม commit ขึ้น git เด็ดขาด (.gitignore ครอบไว้แล้ว)
# 💡 ใช้ .env ไม่ใช่ .env.local — เพราะ Prisma CLI (db:push, studio) อ่านเฉพาะ .env
#    ส่วน Next.js อ่านทั้งสองไฟล์ ใช้ .env ไฟล์เดียวจึงครอบทั้งคู่

# ── Database (Supabase) ──
# Supabase → Project Settings → Database → Connection string (URI)
#
# DATABASE_URL — ใช้ตอน runtime ผ่าน transaction pooler (port 6543)
#   ต้องต่อท้ายด้วย ?pgbouncer=true&connection_limit=1 เสมอ
#   (PgBouncer ไม่รองรับ prepared statements — pgbouncer=true บอกให้ Prisma ปิดมัน
#    และ connection_limit=1 กัน connection บวมบน serverless)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true&connection_limit=1"

# DIRECT_URL — ใช้ตอน db:push / migrate เท่านั้น ต้องต่อตรง (session pooler, port 5432)
#   ถ้าใช้ port 6543 คำสั่ง db:push จะค้างไม่จบ เพราะ PgBouncer ไม่รองรับ DDL + advisory lock
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# ⚠️ ตอน deploy Vercel ต้องตั้ง env ทั้ง DATABASE_URL และ DIRECT_URL ไม่งั้น build fail

# ── LLM API ──
# API key จาก https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Dev mode ──
# ตั้งเป็น true เพื่อใช้ mock data (คน B พัฒนา UI ได้โดยไม่ต้องมี API key)
# ถ้าไม่มี ANTHROPIC_API_KEY ระบบจะใช้ mock ให้อัตโนมัติอยู่แล้ว
USE_MOCK=false
