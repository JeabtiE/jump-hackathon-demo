// ─────────────────────────────────────────────────────────────
// IEP GEN — Database Schema
//
// 🔑 หลักคิดในการออกแบบ:
// 1. PII BOUNDARY — เก็บข้อมูลส่วนบุคคลของนักเรียนใน DB ได้ (โรงเรียนถือข้อมูลนี้
//    อยู่แล้วตามกฎหมาย และจำเป็นสำหรับ export เอกสารทางการ) แต่ข้อมูลใน
//    บล็อก "PII ZONE" ด้านล่างห้ามถูกส่งไปยัง LLM API เด็ดขาด
//    → บังคับด้วย lib/pii-guard.ts ไม่ใช่แค่ความจำของ dev
// 2. เก็บทั้ง aiOriginal และ finalText → ระบบบันทึกอัตโนมัติว่าครูแก้อะไรบ้าง
//    (= หลักฐานสำหรับใบสมัคร ไม่ต้องมานั่งจดมือ)
// 3. แยก Assessment ออกจาก Plan → เก็บพัฒนาการเด็กข้ามปีได้
//    (ตอบโจทย์กฎหมายที่บังคับให้ทบทวนแผนปีละครั้ง)
// 4. ✏️ 17 ส.ค. 2569 — PlanGoal ผูกกับ PlanDomainSection แทนที่จะผูกกับ Plan
//    ตรงๆ เพื่อให้ตรงโครงสร้างเอกสารจริง (1 แถวในตารางส่วนที่ 5 = 1 domain
//    ไม่ใช่ 1 เป้าหมาย) — ดูรายละเอียดที่ model PlanDomainSection ด้านล่าง
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // runtime: ผ่าน transaction pooler (6543) — เหมาะกับ serverless ของ Vercel
  url       = env("DATABASE_URL")
  // migrate/db push: ต้องต่อตรง (session pooler 5432) เพราะ PgBouncer
  // ไม่รองรับ DDL + advisory lock → ถ้าใช้ 6543 คำสั่งจะค้างไม่จบ
  directUrl = env("DIRECT_URL")
}

// ── นักเรียน ────────────────────────────────────────────────
model Student {
  id   String @id @default(cuid())
  /// รหัสอ้างอิงที่ครูตั้งเอง เช่น "A-01" — ใช้แสดงผลในระบบและส่งไป LLM ได้
  ///
  /// ⚠️ ไม่ unique ทั้งระบบแล้ว — unique แค่ภายในครูคนเดียวกัน (@@unique([userId, code]) ท้าย model)
  /// ครูคนละคนตั้ง "A-01" ซ้ำกันเป็นเรื่องปกติ ไม่ควรเป็นความผิดของใคร
  /// → ห้ามใช้ findUnique({ where: { code } }) อีก ต้องเป็น findFirst({ where: { userId, code } })
  code String

  // ══════════════ 🔒 PII ZONE — ห้ามส่งไป LLM API ══════════════
  // ใช้เฉพาะตอน export เอกสาร .docx เท่านั้น
  // ทุก field ในบล็อกนี้ต้องอยู่ใน PII_FIELDS ของ lib/pii-guard.ts
  /// ชื่อ-นามสกุลจริง เช่น "เด็กชายสมชาย ใจดี"
  fullName         String?
  /// เลขประจำตัวประชาชน 13 หลัก
  nationalId       String?
  /// เลขทะเบียนคนพิการ (ถ้ามี)
  disabilityCardNo String?
  /// วันเดือนปีเกิด เก็บเป็น string ตามที่กรอกในฟอร์ม เช่น "5 ต.ค. 2561"
  birthDate        String?
  religion         String?
  /// ลักษณะความพิการแบบละเอียด (ข้อความอิสระจากครู)
  disabilityDetail String?
  fatherName       String?
  motherName       String?
  guardianName     String?
  /// ความเกี่ยวข้องของผู้ปกครอง เช่น "มารดา"
  guardianRelation String?
  address          String?
  phone            String?
  schoolName       String?
  /// สังกัด เช่น "สพป.ชร.เขต1"
  affiliation      String?
  /// ข้อมูลทางการแพทย์ (โรคประจำตัว แพ้ยา ผลตรวจ ฯลฯ)
  medicalNote      String?
  /// ประวัติการศึกษาที่ผ่านมา
  educationHistory String?
  // ══════════════ จบ PII ZONE ══════════════

  gradeLevel     String?
  disabilityType String
  /// บริบทเพิ่มเติมที่ไม่ระบุตัวตน เช่น "เข้าเรียนกลางเทอม"
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ══════════════ OWNERSHIP (Phase 2) ══════════════
  // 🔑 Student คือจุดเดียวในระบบที่บอกว่า "ข้อมูลนี้เป็นของครูคนไหน"
  //    Assessment / Plan / PlanDomainSection / PlanGoal / PlanMedia ตั้งใจไม่มี userId
  //    ทุกอันไต่ผ่าน Student เอา (plan.student.userId) — ถ้าใส่ซ้ำหลายที่ วันหนึ่งมันจะ
  //    ไม่ตรงกันแล้วไม่มีใครรู้ว่าอันไหนถูก
  //
  // ✅ required แล้ว — นักเรียนทุกแถวต้องมีเจ้าของเสมอ ไม่มีข้อยกเว้น
  //    (ผ่าน scripts/backfill-owner.ts มาแล้ว ดู MIGRATION-NOTES.md)
  //    ⚠️ ห้ามเปลี่ยนกลับเป็น String? — แถวที่ userId เป็น null จะไม่ตรงกับ
  //    where ของใครเลย กลายเป็นข้อมูลที่ไม่มีใครเข้าถึงได้ แต่ยังนั่งอยู่ใน DB
  //
  // 🔒 ไม่ใช่ PII (เป็น FK ภายในระบบ ไม่ได้ระบุตัวตนนักเรียน) → ไม่ต้องแตะ PII_FIELDS
  //    ใน lib/pii-guard.ts และ buildLLMSafePayload เป็น whitelist อยู่แล้ว จึงไม่รั่วไป LLM
  //
  // ⚠️ onDelete: Restrict โดยตั้งใจ — ลบบัญชีครูต้องไม่ลากข้อมูลนักเรียนหายตามไปด้วย
  //    ต้องย้ายเจ้าของก่อนถึงจะลบ User ได้
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  // ══════════════ จบ OWNERSHIP ══════════════

  assessments Assessment[]
  plans       Plan[]

  @@index([disabilityType])
  @@index([userId])
  /// รหัสนักเรียนซ้ำข้ามครูได้ แต่ห้ามซ้ำภายในครูคนเดียวกัน
  /// ⚠️ ใช้ได้เพราะ userId เป็น required แล้วเท่านั้น — ถ้า userId ยัง nullable
  ///    Postgres ถือว่า NULL ไม่เท่ากับ NULL แถวที่ไม่มีเจ้าของจะซ้ำได้ไม่จำกัด
  @@unique([userId, code])
}

// ── การประเมินความสามารถ (แยกจาก Plan เพื่อเก็บพัฒนาการข้ามปี) ──
model Assessment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// { "reading": "cannot_spell_2syllable", "communication": "no_speech_gesture_only" }
  /// ⚠️ ค่าที่ครูยืนยันแล้ว — เป็นค่าเดียวที่ retrieval ใช้ (ห้ามใช้ค่าที่ AI เสนอแทน)
  abilityLevels            Json
  /// ข้อความอิสระที่ครูพิมพ์ต่อ domain { "reading": "อ่านคำ 2 พยางค์ไม่ได้..." }
  /// ⚠️ ไม่ใช่ PII ZONE — ไหลเข้า LLM ได้ (generation + audit) แต่ต้องผ่าน scrubFreeText() ก่อน
  abilityFreeText          Json?
  /// ค่า enum ที่ AI เสนอจาก abilityFreeText ก่อนครูแก้ — audit แบบเดียวกับ aiOriginal
  /// ห้ามเขียนทับหลังบันทึกครั้งแรก และห้ามใช้แทน abilityLevels
  abilityLevelsAiSuggested Json?
  /// จุดเด่น/สิ่งที่ทำได้ — ⚠️ ค่ารวมทั้งแผน (legacy) ตั้งแต่มี PlanDomainSection
  /// แล้ว จุดเด่น/จุดที่ควรพัฒนาแบบละเอียดต่อ domain ย้ายไปอยู่ที่นั่นแทน
  /// ฟิลด์นี้ยังคงไว้เพื่อ backward-compat กับแผนเก่า และเป็น fallback
  /// ตอนส่ง prompt ถ้ายังไม่มีข้อมูลต่อ domain
  strengths                String?

  assessedAt DateTime @default(now())

  plans Plan[]

  @@index([studentId])
}

// ── แผน IEP หนึ่งฉบับ ────────────────────────────────────────
model Plan {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  /// ปีการศึกษา เช่น "2569"
  academicYear String
  /// ภาคเรียน "1" | "2"
  term         String

  /// draft = ยังแก้อยู่ | finalized = ครูยืนยันแล้ว
  status String @default("draft")

  /// ── ส่วนที่ 7: คณะกรรมการจัดทำแผน ──
  /// เก็บต่อแผน (ไม่ใช่ค่าคงที่ทั้งโรงเรียน) เพราะกรรมการเปลี่ยนตามนักเรียน/ชั้นเรียน
  /// ชื่อ "บิดา มารดา หรือผู้ปกครอง" ไม่เก็บซ้ำที่นี่ — ดึงจาก Student.guardianName ตอน export
  principalName          String?
  responsibleTeacherName String?
  homeroomTeacherName    String?
  /// เก็บเป็น String "YYYY-MM-DD" ไม่ใช่ DateTime — เป็นวันที่ล้วนไม่มีเวลา
  /// ถ้าใช้ DateTime จะเพี้ยนข้ามวันเวลาแปลง UTC ↔ +07:00
  meetingDate            String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// เวลาที่ครูกดยืนยัน → createdAt ถึง finalizedAt = เวลาที่ใช้ทำแผนจริง
  finalizedAt DateTime?

  /// ✏️ 17 ส.ค. 2569 — เป้าหมายไม่ผูกกับ Plan ตรงๆ อีกต่อไป แต่ผูกผ่าน
  /// PlanDomainSection แทน (ดูเหตุผลที่ model นั้น)
  domainSections PlanDomainSection[]
  media          PlanMedia[]

  @@index([studentId])
  @@index([status])
}

// ── หนึ่งแถวในตารางส่วนที่ 5 ของเอกสารจริง (1 domain ต่อ 1 แถว) ──
// ✏️ ใหม่ 17 ส.ค. 2569 — ยืนยันโครงสร้างจากเอกสารจริง 3 ฉบับ (นักเรียนต่างโรงเรียน
//    ต่างประเภทความพิการ แต่โครงสร้างตารางเหมือนกันเป๊ะ): 1 แถว = 1 domain ประกอบด้วย
//    จุดเด่น + จุดที่ควรพัฒนา + เป้าหมายระยะยาว 1 ปี + จุดประสงค์ระยะสั้นหลายข้อ +
//    วิธีประเมินผล + ผู้รับผิดชอบ — ไม่ใช่ 1 แถวต่อ 1 เป้าหมายแบบที่ระบบเคยทำ
model PlanDomainSection {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// key เดียวกับที่ใช้ใน AssessmentForm.tsx (ABILITY_OPTIONS) เช่น "communication",
  /// "math", "selfHelp" — ต้องตรงกัน ไม่งั้น getDomainLabel() หา label ไม่เจอ
  domain String

  /// ⚠️ AI ร่างจากค่า dropdown (abilityLevels) ที่ครูเลือกไว้ — ห้ามแก้ ใช้เทียบว่า
  /// ครูแก้อะไรบ้าง (เหมือน pattern aiOriginal/finalText ของ PlanGoal)
  aiStrengths    String
  finalStrengths String

  aiDevelopmentAreas    String
  finalDevelopmentAreas String

  /// เป้าหมายระยะยาว 1 ปี — ข้อความอิสระ 1 ก้อนต่อ domain (ไม่ใช่ต่อเป้าหมายย่อย)
  aiLongTermGoal    String
  finalLongTermGoal String

  /// วิธีการประเมินผล เช่น "การสังเกตพฤติกรรม, การบันทึกข้อมูล" — 1 ค่าต่อ domain
  /// ⚠️ concept นี้ต่างจาก PlanGoal.criterion (เกณฑ์ผ่านของเป้าหมายย่อยแต่ละข้อ)
  aiEvaluationMethod    String
  finalEvaluationMethod String

  /// ผู้รับผิดชอบ domain นี้ — ครูกรอกเอง ไม่ใช่ AI คิด (ไม่มีข้อมูลให้ AI เดาได้)
  responsibleTeacherName String?

  orderIndex Int @default(0)

  /// จุดประสงค์เชิงพฤติกรรม (เป้าหมายระยะสั้น) — หลายข้อต่อ 1 domain
  goals PlanGoal[]

  @@index([planId])
}

// ── เป้าหมายเชิงพฤติกรรม (จุดประสงค์ระยะสั้น 1 ข้อ) ───────────────
model PlanGoal {
  id        String            @id @default(cuid())
  sectionId String
  section   PlanDomainSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  /// ⚠️ ข้อความที่ AI ร่างครั้งแรก — ห้ามแก้ ใช้เทียบว่าครูแก้อะไรบ้าง
  aiOriginal String
  /// ข้อความหลังครูแก้ (ถ้าไม่แก้ = เท่ากับ aiOriginal)
  finalText  String

  /// ⚠️ เกณฑ์ผ่าน/ระยะเวลา เก็บไว้แยกเผื่อ UI ต้องการแก้เป็นช่องย่อย แต่ตอน export
  /// เอกสารจริงไม่มีคอลัมน์แยก — ข้อความนี้ถูกฝังรวมอยู่ใน finalText อยู่แล้ว
  /// (เช่น "...ได้อย่างน้อย 4 ใน 5 ครั้ง ภายใน 3 เดือน") ไม่ต้องคัดลอกซ้ำตอน render
  criterion String?
  timeframe String?

  /// ⚠️ รหัสตัวชี้วัดที่ AI เลือกครั้งแรก เช่น ["ท 1.1 ป.1/1"] — ห้ามแก้
  /// คัดจาก data/curriculum.json ผ่าน retrieveIndicators() เท่านั้น AI คิดรหัสเองไม่ได้
  /// [] = เป้าหมายด้านทักษะที่ไม่ได้อ้างกลุ่มสาระ (สื่อสาร/ช่วยเหลือตนเอง) — ไม่ใช่ข้อผิดพลาด
  aiIndicatorCodes    String[] @default([])
  /// รหัสหลังครูแก้ (ไม่แก้ = เท่ากับ aiIndicatorCodes) → รู้เองว่า AI จับคู่ตัวชี้วัดแม่นแค่ไหน
  finalIndicatorCodes String[] @default([])

  /// ครูเลือกเป้าหมายข้อนี้ไปใช้จริงหรือไม่
  isSelected Boolean @default(false)
  orderIndex Int     @default(0)

  @@index([sectionId])
}

// ── สื่อ/สิ่งอำนวยความสะดวก (บัญชี ก/ข) ──────────────────────
model PlanMedia {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// ชื่อสื่อ — มาจาก mappingTable.json เท่านั้น ไม่ใช่ AI คิดเอง
  item     String
  /// "ก" (ขอยืม) | "ข" (ขอรับเงินอุดหนุน) | "ค" (รับบริการ)
  category String
  /// รหัสรายการตามคู่มือ พ.ศ. 2568 เช่น "BE1784" — nullable เพราะแผนที่สร้างก่อนมีคู่มือไม่มีรหัส
  code     String?
  /// ราคาตามคู่มือ เก็บเป็น string ตามที่คู่มือเขียน เช่น "2,000 บาท / ชุด"
  /// (ไม่แปลงเป็นตัวเลข เพราะหน่วยไม่เท่ากัน: ต่อชุด/ต่อเล่ม/ต่อครั้ง/ต่อชั่วโมง)
  price    String?
  /// วิธีการได้มา: "ขอรับ" | "ขอยืม" | "รับบริการ" — ช่อง "วิธีการ" ในแบบฟอร์มส่วนที่ 6
  mode     String?

  /// เหตุผลที่ AI ร่างครั้งแรก
  aiReason    String
  /// เหตุผลหลังครูแก้
  finalReason String

  /// ครูยืนยันว่าจะเบิกจริงหรือไม่
  isApproved Boolean @default(true)

  @@index([planId])
}

// ═════════════════════════════════════════════════════════════
// PHASE 2 — AUTH ZONE (Auth.js v5 / @auth/prisma-adapter)
//
// 🔑 4 model ล่างนี้เป็น "สเปคของ adapter" ไม่ใช่ของเรา — ชื่อ field ต้องตรงเป๊ะ
//    (รวมทั้งชื่อ snake_case ใน Account ที่ดูขัดกับที่อื่นในไฟล์นี้) ห้ามเปลี่ยนชื่อ
//    ให้เข้ากับ convention ของโปรเจกต์ ไม่งั้น adapter หาไม่เจอตอน runtime
//    อ้างอิง: https://authjs.dev/getting-started/adapters/prisma
//
// 🔒 ไม่มี field ไหนในโซนนี้เป็น PII ของ "นักเรียน" (เป็นข้อมูลบัญชีของ "ครู")
//    → ไม่ต้องเพิ่มใน PII_FIELDS ของ lib/pii-guard.ts
//    PII ZONE ของนักเรียนยังอยู่ที่ model Student ที่เดียวเหมือนเดิม
//
// 💡 ไม่ได้ใส่ model Authenticator (WebAuthn/passkey) — เพิ่มทีหลังได้ถ้าจะใช้
// ═════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  /// required + unique — เป็นกุญแจที่ใช้จับคู่กับ AllowedEmail
  email         String    @unique
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  /// นักเรียนที่ครูคนนี้เป็นเจ้าของข้อมูล
  students Student[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  /// ไม่มี @id — adapter ใช้ sessionToken เป็น unique criteria (ตามสเปค v5)
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ── รายชื่ออีเมลที่อนุญาตให้เข้าระบบ (allowlist) ─────────────────
// ไม่ใช่ของ adapter — เป็นของเราเอง ใช้ใน callback signIn ตอน Phase 2:
// อีเมลที่ไม่อยู่ในตารางนี้ = login ไม่ผ่าน (ระบบมี PII ของเด็ก เปิดให้ใครก็สมัครไม่ได้)
model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  /// บันทึกช่วยจำว่าใคร/ทำไมถึงอนุญาต เช่น "ครูพี่เลี้ยง ร.ร.บ้านสันโค้ง"
  note      String?
  createdAt DateTime @default(now())
}
